-- Client cache
CREATE TABLE client_cache (
    id TEXT NOT NULL,
    tenant_slug TEXT NOT NULL,
    json TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    PRIMARY KEY(id, tenant_slug)
);

-- Supplier cache
CREATE TABLE supplier_cache (
    id TEXT NOT NULL,
    tenant_slug TEXT NOT NULL,
    json TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    PRIMARY KEY(id, tenant_slug)
);

-- Sales invoice cache
CREATE TABLE sales_invoice_cache (
    id TEXT NOT NULL,
    tenant_slug TEXT NOT NULL,
    status TEXT NOT NULL,
    json TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    PRIMARY KEY(id, tenant_slug)
);

-- Purchase invoice cache
CREATE TABLE purchase_invoice_cache (
    id TEXT NOT NULL,
    tenant_slug TEXT NOT NULL,
    status TEXT NOT NULL,
    json TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    PRIMARY KEY(id, tenant_slug)
);

-- POS shift cache
CREATE TABLE shift_cache (
    id TEXT NOT NULL,
    tenant_slug TEXT NOT NULL,
    terminal_id TEXT NOT NULL,
    status TEXT NOT NULL,
    json TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    PRIMARY KEY(id, tenant_slug)
);

-- POS order cache (pending/offline orders)
CREATE TABLE pending_order_cache (
    local_id TEXT NOT NULL PRIMARY KEY,
    tenant_slug TEXT NOT NULL,
    shift_id TEXT NOT NULL,
    json TEXT NOT NULL,
    created_at TEXT NOT NULL,
    synced INTEGER NOT NULL DEFAULT 0
);

-- Expense cache
CREATE TABLE expense_cache (
    id TEXT NOT NULL,
    tenant_slug TEXT NOT NULL,
    json TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    PRIMARY KEY(id, tenant_slug)
);

-- ── Client queries ────────────────────────────────────────────────────────────

upsertClient:
INSERT OR REPLACE INTO client_cache(id, tenant_slug, json, updated_at)
VALUES (?, ?, ?, ?);

selectClientsByTenant:
SELECT json FROM client_cache WHERE tenant_slug = ? ORDER BY id;

selectClientById:
SELECT json FROM client_cache WHERE id = ? AND tenant_slug = ?;

deleteClientsByTenant:
DELETE FROM client_cache WHERE tenant_slug = ?;

-- ── Supplier queries ──────────────────────────────────────────────────────────

upsertSupplier:
INSERT OR REPLACE INTO supplier_cache(id, tenant_slug, json, updated_at)
VALUES (?, ?, ?, ?);

selectSuppliersByTenant:
SELECT json FROM supplier_cache WHERE tenant_slug = ? ORDER BY id;

selectSupplierById:
SELECT json FROM supplier_cache WHERE id = ? AND tenant_slug = ?;

deleteSuppliersByTenant:
DELETE FROM supplier_cache WHERE tenant_slug = ?;

-- ── Sales invoice queries ─────────────────────────────────────────────────────

upsertSalesInvoice:
INSERT OR REPLACE INTO sales_invoice_cache(id, tenant_slug, status, json, updated_at)
VALUES (?, ?, ?, ?, ?);

selectSalesInvoicesByTenant:
SELECT json FROM sales_invoice_cache WHERE tenant_slug = ? ORDER BY id DESC;

selectSalesInvoicesByStatus:
SELECT json FROM sales_invoice_cache WHERE tenant_slug = ? AND status = ? ORDER BY id DESC;

selectSalesInvoiceById:
SELECT json FROM sales_invoice_cache WHERE id = ? AND tenant_slug = ?;

deleteSalesInvoicesByTenant:
DELETE FROM sales_invoice_cache WHERE tenant_slug = ?;

-- ── Purchase invoice queries ──────────────────────────────────────────────────

upsertPurchaseInvoice:
INSERT OR REPLACE INTO purchase_invoice_cache(id, tenant_slug, status, json, updated_at)
VALUES (?, ?, ?, ?, ?);

selectPurchaseInvoicesByTenant:
SELECT json FROM purchase_invoice_cache WHERE tenant_slug = ? ORDER BY id DESC;

selectPurchaseInvoicesByStatus:
SELECT json FROM purchase_invoice_cache WHERE tenant_slug = ? AND status = ? ORDER BY id DESC;

selectPurchaseInvoiceById:
SELECT json FROM purchase_invoice_cache WHERE id = ? AND tenant_slug = ?;

deletePurchaseInvoicesByTenant:
DELETE FROM purchase_invoice_cache WHERE tenant_slug = ?;

-- ── Shift queries ─────────────────────────────────────────────────────────────

upsertShift:
INSERT OR REPLACE INTO shift_cache(id, tenant_slug, terminal_id, status, json, updated_at)
VALUES (?, ?, ?, ?, ?, ?);

selectOpenShiftByTenant:
SELECT json FROM shift_cache WHERE tenant_slug = ? AND status = 'open' LIMIT 1;

selectShiftsByTenant:
SELECT json FROM shift_cache WHERE tenant_slug = ? ORDER BY id DESC;

deleteShiftsByTenant:
DELETE FROM shift_cache WHERE tenant_slug = ?;

-- ── Pending order queries ─────────────────────────────────────────────────────

insertPendingOrder:
INSERT INTO pending_order_cache(local_id, tenant_slug, shift_id, json, created_at, synced)
VALUES (?, ?, ?, ?, ?, 0);

selectPendingOrdersByTenant:
SELECT local_id, json FROM pending_order_cache
WHERE tenant_slug = ? AND synced = 0
ORDER BY created_at;

markOrderSynced:
UPDATE pending_order_cache SET synced = 1 WHERE local_id = ?;

deleteSyncedOrders:
DELETE FROM pending_order_cache WHERE tenant_slug = ? AND synced = 1;

-- ── Expense queries ───────────────────────────────────────────────────────────

upsertExpense:
INSERT OR REPLACE INTO expense_cache(id, tenant_slug, json, updated_at)
VALUES (?, ?, ?, ?);

selectExpensesByTenant:
SELECT json FROM expense_cache WHERE tenant_slug = ? ORDER BY id DESC;

deleteExpensesByTenant:
DELETE FROM expense_cache WHERE tenant_slug = ?;
